.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
# .git NÃO está aqui de propósito: o Dockerfile lê .git/ pra resolver o
# commit (scripts/resolve_git_commit.py) e remove antes de terminar a imagem
# final — ver Dockerfile. Se excluir aqui, o build sempre reporta "unknown".
.gitignore
*.md
.env
.env.*
!.env.example
tests/
infra/
*.egg-info
dist/
build/
