# ── Banco de dados (PostgreSQL)
# No EasyPanel: use o hostname interno do serviço Postgres
# Exemplo: postgresql+asyncpg://contabil:SENHA@postgres:5432/contabil_db
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME

# ── Banco de PRODUÇÃO — usado apenas pelos scripts de manutenção da raiz
# (check_prod_concilpro.py, reset_concilpro_prod.py, migrate_apply.py,
#  reprocessar_concilpro.py). A aplicação NÃO lê esta variável.
# Deixe em branco em qualquer máquina que não deva tocar produção.
PROD_DATABASE_URL=postgres://USUARIO:SENHA@HOST:PORTA/BANCO

# ── Redis
REDIS_URL=redis://redis:6379/0

# ── Segurança (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SEGURA_DE_64_CHARS

# ── Ambiente
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0

# ── Cookies (producao: sempre true)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── CORS — domínio do frontend no EasyPanel
ALLOWED_ORIGINS=https://app.seudominio.com.br

# ── OpenAI (necessário para o CONCILPRO — parsing de PDFs)
OPENAI_API_KEY=sk-proj-...

# ── Open Banking (opcional)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Consentimento explícito para enviar texto/imagens de extratos ao provedor OpenAI.
ALLOW_FINANCIAL_DATA_TO_OPENAI=false
PDF_MAX_PAGES=25
PDF_PARSE_TIMEOUT_SECONDS=60
PDF_MAX_AI_CALLS=10
